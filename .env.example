DATABASE_URL=postgresql://pdc:pdc@localhost:5438/portal_defesa_civil
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_TTL=7d
MAIL_HOST=localhost
MAIL_PORT=1025
# Vazios em dev (Mailpit nao pede auth). Em producao, credenciais do provedor.
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM=Programa de evolução contínua LGND SQUAD <noreply@localhost>
WEB_BASE_URL=http://localhost:3000

# Roda o seed a cada boot do container. O seed e idempotente por contrato:
# mantem o catalogo autocorrigido. Desligue quando o conteudo estabilizar.
SEED_ON_BOOT=true
# Pula a prova de e-mail. Em producao o default e true (SMTP ainda nao entrega).
# Em dev deixe false para exercitar o fluxo do Mailpit. AUTO_VERIFY_EMAIL=false
# religa a verificacao quando o dominio no Resend estiver ok.
AUTO_VERIFY_EMAIL=false
