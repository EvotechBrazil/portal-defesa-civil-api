DATABASE_URL=postgresql://pdc:pdc@localhost:5438/portal_defesa_civil
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_TTL=7d
MAIL_HOST=localhost
MAIL_PORT=1025
# Vazios em dev (Mailpit nao pede auth). Em producao, credenciais do provedor.
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM=Programa de evolução contínua LGND SQUAD <noreply@localhost>
WEB_BASE_URL=http://localhost:3000

# Roda o seed a cada boot do container. O seed e idempotente por contrato:
# mantem o catalogo autocorrigido. Desligue quando o conteudo estabilizar.
SEED_ON_BOOT=true
# Pula a verificacao por e-mail. Use APENAS enquanto nao houver SMTP real —
# o acesso ja e fechado pela lista de WhatsApp, mas o e-mail deixa de ser provado.
AUTO_VERIFY_EMAIL=false
